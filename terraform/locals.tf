locals {
  registry_dir      = coalesce(var.registry_dir, "${path.module}/../apps")
  inventory_file    = coalesce(var.inventory_file, "${path.module}/../inventory/inventory.json")
  repositories_file = coalesce(var.repositories_file, "${path.module}/../repositories.yaml")

  now = coalesce(var.now, plantimestamp())

  # --- Managed workload repositories ----------------------------------------------------------------------------

  repositories = {
    for name, r in try(yamldecode(file(local.repositories_file)), {}) : name => {
      description = try(tostring(r.description), "")
      topics      = try(tolist(r.topics), [])
    }
  }

  # --- Registry: one YAML file per app; the file name is the app's logical name --------------------------------

  app_fields = toset([
    "slug", "owner_team", "escalation", "purpose", "criticality", "declared_tier", "approved_permissions",
    "review_by", "status", "repositories", "bypass", "ticket",
  ])

  apps_raw = {
    for f in fileset(local.registry_dir, "*.yaml") :
    trimsuffix(f, ".yaml") => yamldecode(file("${local.registry_dir}/${f}"))
  }

  # Normalised to one object type, so that a malformed field fails a precondition with a clear message instead of
  # a type error somewhere downstream.
  apps = {
    for name, raw in local.apps_raw : name => {
      slug                 = try(tostring(raw.slug), null)
      owner_team           = try(tostring(raw.owner_team), null)
      escalation           = try(tostring(raw.escalation), null)
      purpose              = try(tostring(raw.purpose), null)
      criticality          = try(tostring(raw.criticality), "standard")
      declared_tier        = try(tostring(raw.declared_tier), null)
      approved_permissions = try(tomap(raw.approved_permissions), {})
      review_by            = try(tostring(raw.review_by), null)
      status               = try(tostring(raw.status), null)
      repositories         = try(tolist(raw.repositories), [])
      bypass               = try(tolist(raw.bypass), [])
      ticket               = try(tostring(raw.ticket), null)
      unknown_fields       = try(sort(setsubtract(keys(raw), local.app_fields)), ["<not a YAML mapping>"])
    }
  }

  app_slug = { for name, app in local.apps : name => coalesce(app.slug, "${var.app_slug_prefix}${name}") }

  # --- Inventory: generated by scripts/inventory.sh, committed and reviewed (D-003) ----------------------------

  inventory = jsondecode(file(local.inventory_file))

  installations = {
    for slug, i in try(local.inventory.installations, {}) : slug => {
      installation_id      = tostring(i.installation_id)
      app_id               = tostring(i.app_id)
      repository_selection = tostring(i.repository_selection)
      suspended            = try(tobool(i.suspended), false)
      permissions          = try(tomap(i.permissions), {})
    }
  }

  installation = { for name, slug in local.app_slug : name => lookup(local.installations, slug, null) }

  # --- Risk tier: derived from the permissions the installation actually holds -----------------------------------
  # The effective tier is max(declared, derived). It drives the review interval and who must review, and it is
  # never derived from live API data at plan time.

  level_rank = { read = 1, write = 2, admin = 3 }
  tier_rank  = { low = 0, medium = 1, high = 2 }

  # Repository permissions that are high-risk at write level: code, CI, secrets, deployment targets, webhooks.
  high_risk_permissions = ["actions", "administration", "contents", "environments", "repository_hooks", "secrets", "workflows"]

  derived_tier = {
    for name, app in local.apps : name => (
      local.installation[name] == null ? "high" : (
        anytrue(concat(
          # any organization-level permission
          [for p, lvl in local.installation[name].permissions : startswith(p, "organization_") || p == "members"],
          [for p, lvl in local.installation[name].permissions : contains(local.high_risk_permissions, p) && lookup(local.level_rank, lvl, 0) >= 2],
          [length(app.bypass) > 0, local.installation[name].repository_selection == "all"],
          )) ? "high" : (
          anytrue([for p, lvl in local.installation[name].permissions : lookup(local.level_rank, lvl, 0) >= 2]) ? "medium" : "low"
        )
      )
    )
  }

  effective_tier = {
    for name, app in local.apps : name => (
      try(local.tier_rank[app.declared_tier] > local.tier_rank[local.derived_tier[name]], false)
      ? app.declared_tier : local.derived_tier[name]
    )
  }

  # --- Review and expiry (D-008) ---------------------------------------------------------------------------------

  review_at  = { for name, app in local.apps : name => try(timeadd("${app.review_by}T00:00:00Z", "0h"), null) }
  expires_at = { for name, t in local.review_at : name => try(timeadd(t, "${var.expiry_grace_days * 24}h"), null) }

  # Review dates only matter for apps that still have real access.
  in_review = { for name, app in local.apps : name => app.status != "quarantined" }

  overdue  = { for name, t in local.review_at : name => local.in_review[name] && try(timecmp(local.now, t) >= 0, false) }
  expired  = { for name, t in local.expires_at : name => local.in_review[name] && try(timecmp(local.now, t) >= 0, false) }
  due_soon = { for name, t in local.review_at : name => local.in_review[name] && !local.overdue[name] && try(timecmp(timeadd(local.now, "${var.review_warning_days * 24}h"), t) >= 0, false) }

  auto_quarantined = {
    for name, app in local.apps : name => app.status == "active" && local.expired[name] && app.criticality != "business-critical"
  }

  effective_status = { for name, app in local.apps : name => local.auto_quarantined[name] ? "quarantined" : app.status }

  # A quarantined app keeps its installation (GitHub requires at least one repository) but only sees the archived
  # quarantine repo.
  effective_repos = {
    for name, app in local.apps : name => local.effective_status[name] == "quarantined" ? [var.quarantine_repo] : app.repositories
  }

  # --- Rules that apps depend on ----------------------------------------------------------------------------------
  # Bypass is granted per repository, and only where the app is installed: GitHub rejects an Integration bypass
  # for an app that isn't installed on the repository (422, spike S4).

  bypass_by_repo = {
    for repo in keys(local.repositories) : repo => sort(distinct([
      for name, app in local.apps : local.installation[name].app_id
      if local.installation[name] != null && local.effective_status[name] == "active" && contains(app.bypass, "require-pr") && contains(local.effective_repos[name], repo)
    ]))
  }

  # --- Signals for check blocks (warnings, never blocking) ---------------------------------------------------------

  registered_slugs   = toset(values(local.app_slug))
  unregistered_slugs = sort([for slug, i in local.installations : slug if !contains(local.registered_slugs, slug)])
  all_repos_slugs    = sort([for slug, i in local.installations : slug if i.repository_selection == "all"])

  # Live permissions above what was approved, e.g. after an owner accepted a vendor's permission update.
  permission_creep = {
    for name, app in local.apps : name => sort([
      for p, lvl in try(local.installation[name].permissions, {}) : "${p}:${lvl}"
      if lookup(local.level_rank, lvl, 0) > lookup(local.level_rank, lookup(app.approved_permissions, p, "none"), 0)
    ])
  }

  team_slugs = toset([for t in data.github_organization_teams.all.teams : t.slug])
}
